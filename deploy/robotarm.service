[Unit]
Description=Robotic Arm pick-and-place demo (start at power-up, auto-recover)
# No After=weston.service: on the RZ/V2H image weston.service is itself ordered
# after multi-user.target, so that would be an ordering cycle and systemd
# would drop this service at boot. The supervisor waits for Weston's socket.
After=network.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=/usr/bin:/bin:/usr/sbin:/sbin
Environment=HOME=/root
# What the arm does at power-up: yolo-pickplace (start moving balls) or idle
# (hold still until started from IOTCONNECT). deploy/install_service.sh [mode]
# rewrites this line, and the path below to wherever the repo lives.
Environment=BOOT_MODE=yolo-pickplace
ExecStart=/bin/sh /root/iotc-renesas-rzv2h-robotic-arm/deploy/arm_watchdog.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
