venv/
__pycache__/
*.pyc
.DS_Store

# Editor / tooling state — personal, not for the repo
.claude/
.vscode/
.idea/


# vim swap / undo files
*.un~
*.swp
*.swo

# Backup files made by deploy scripts (timestamped backups of overwritten files)
*.bak-*
*~

# Runtime state — generated on the board, never committed:
#   - per-board calibration values (camera, HSV, geometry)
#   - per-deployment IOTCONNECT credentials
#   - launcher logs
ball_color.json
box_color.json
box_pose.json
drop_pose.json
scan_poses.json
camera_settings.json
camera_presets.json
cam_gripper_offset.json
grab_depth.json
grab_threshold.json
approach_limits.json
yolo_config.json
iotcDeviceConfig.json
device-cert.pem
device-pkey.pem
run.log
launch_gui.log
calibrate.log
calibrate_offset.log
teach.log
setup.log
setup.exit
sweep-results.txt
teach_pose.json
tmp/
icons/
yolov8n.pt

# Custom ball-model training data + artifacts (large, regenerable)
dataset/
runs/
*.tflite
*.onnx
*.zip
best.pt
# ...except the bundled custom ball detector (CPU fallback), which ships in the repo
!model/ball_best.tflite

# DRP-AI TVM build inputs/outputs (drpai/ — see CUSTOM_DRPAI_DETECTOR.md).
# Renesas' installers are licensed downloads and must not be committed.
drpai/downloads/*
!drpai/downloads/README.md
drpai/build/
model/*_drpai/
# ...except the bundled DRP-AI ball detector
!model/ball_drpai/
